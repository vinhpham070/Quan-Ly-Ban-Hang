<Window x:Class="QuanLyBanHang.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuanLyBanHang"
        mc:Ignorable="d"
        Title="Login" Height="460" Width="340"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F8FAFC">

    <Border Background="White" Margin="18" Padding="20" CornerRadius="10"
            BorderBrush="#E2E8F0" BorderThickness="1">
        <Grid VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Image Width="85" Height="85" Grid.Row="0" Margin="0,0,0,8" Stretch="Uniform">
                <Image.Source>
                    <BitmapImage DecodePixelWidth="250" UriSource="/Images/LoginLogo.png"/>
                </Image.Source>
            </Image>

            <TextBlock Text="ĐĂNG NHẬP" Grid.Row="1" FontSize="22" FontWeight="Bold"
                       Foreground="#1E3A8A" HorizontalAlignment="Center" Margin="0,0,0,18"/>

            <TextBlock Text="Tên đăng nhập" Grid.Row="2" FontSize="13" FontWeight="SemiBold"
                       Foreground="#475569" Margin="0,0,0,4"/>
            <TextBox x:Name="tbUsername" Grid.Row="3" Height="34" FontSize="14"
                     Padding="8,0" VerticalContentAlignment="Center"
                     BorderBrush="#CBD5E1" Margin="0,0,0,12"/>

            <TextBlock Text="Mật khẩu" Grid.Row="4" FontSize="13" FontWeight="SemiBold"
                       Foreground="#475569" Margin="0,0,0,4"/>
            <PasswordBox x:Name="tbPassword" Grid.Row="5" Height="34" FontSize="14"
                         Padding="8,0" VerticalContentAlignment="Center"
                         BorderBrush="#CBD5E1" Margin="0,0,0,20"/>

            <!-- Hai nút Đăng nhập & Thoát -->
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnLogin" Content="Đăng nhập" Grid.Column="0" Height="36"
                        Background="#2563EB" Foreground="White" FontWeight="SemiBold" FontSize="14"
                        BorderThickness="0" Cursor="Hand" IsDefault="True"
                        Click="btnLogin_Click"/>

                <Button x:Name="btnExit" Content="Thoát" Grid.Column="2" Height="36"
                        Background="#E2E8F0" Foreground="#334155" FontWeight="SemiBold" FontSize="14"
                        BorderThickness="0" Cursor="Hand" IsCancel="True"
                        Click="btnExit_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>