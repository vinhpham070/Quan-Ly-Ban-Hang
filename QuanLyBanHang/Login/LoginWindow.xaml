<Window Background="#F8FAFC" Height="460" ResizeMode="NoResize" Title="Login" Width="340" WindowStartupLocation="CenterScreen" mc:Ignorable="d" x:Class="QuanLyBanHang.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:QuanLyBanHang" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.Resources>
        <!-- Applies CornerRadius="6" to the internal Border of TextBox, PasswordBox, and Button -->
        <Style TargetType="Border" x:Key="RoundCorner6">
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style TargetType="Hyperlink" x:Key="ModernHyperlink">
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextDecorations" Value="None"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#1D4ED8"/>
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style nút con mắt -->
        <Style TargetType="ToggleButton" x:Key="EyeToggleStyle">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Content" Value="&#xE7B3;"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#1E293B"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#2563EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Margin="18" Padding="20">
        <Grid VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Image Grid.Row="0" Height="85" Margin="0,0,0,8" Stretch="Uniform" Width="85">
                <Image.Source>
                    <BitmapImage DecodePixelWidth="250" UriSource="/Images/LoginLogo.png"/>
                </Image.Source>
            </Image>

            <TextBlock FontSize="22" FontWeight="Bold" Foreground="#1E3A8A" Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,18" Text="ĐĂNG NHẬP"/>

            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#475569" Grid.Row="2" Margin="0,0,0,4" Text="Tên đăng nhập"/>
            <TextBox BorderBrush="#CBD5E1" FontSize="14" Grid.Row="3" Height="34" Margin="0,0,0,12" Padding="8,0" VerticalContentAlignment="Center" x:Name="tbUsername">
                <TextBox.Resources>
                    <Style BasedOn="{StaticResource RoundCorner6}" TargetType="Border"/>
                </TextBox.Resources>
            </TextBox>

            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#475569" Grid.Row="4" Margin="0,0,0,4" Text="Mật khẩu"/>
            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Grid.Row="5" Height="34" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <PasswordBox Background="Transparent" BorderThickness="0" FontSize="14" Grid.Column="0" Padding="8,0" PasswordChanged="tbPassword_PasswordChanged" VerticalContentAlignment="Center" x:Name="tbPassword"/>
                    <TextBox Background="Transparent" BorderThickness="0" FontSize="14" Grid.Column="0" Padding="8,0" TextChanged="tbPasswordVisible_TextChanged" VerticalContentAlignment="Center" Visibility="Collapsed" x:Name="tbPasswordVisible"/>

                    <ToggleButton Checked="btnTogglePass_Changed" Grid.Column="1" Style="{StaticResource EyeToggleStyle}" Unchecked="btnTogglePass_Changed" x:Name="btnTogglePass"/>
                </Grid>
            </Border>

            <!-- Hai nút Đăng nhập & Thoát -->
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Background="#2563EB" BorderThickness="0" Click="btnLogin_Click" Content="Đăng nhập" Cursor="Hand" FontSize="14" FontWeight="SemiBold" Foreground="White" Grid.Column="0" Height="36" IsDefault="True" x:Name="btnLogin">
                    <Button.Resources>
                        <Style BasedOn="{StaticResource RoundCorner6}" TargetType="Border"/>
                    </Button.Resources>
                </Button>

                <Button Background="#E2E8F0" BorderThickness="0" Click="btnExit_Click" Content="Thoát" Cursor="Hand" FontSize="14" FontWeight="SemiBold" Foreground="#334155" Grid.Column="2" Height="36" IsCancel="True" x:Name="btnExit">
                    <Button.Resources>
                        <Style BasedOn="{StaticResource RoundCorner6}" TargetType="Border"/>
                    </Button.Resources>
                </Button>
            </Grid>

            
        </Grid>
    </Border>
</Window>